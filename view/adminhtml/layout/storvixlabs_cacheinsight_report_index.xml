    <head>
        <css src="StorvixLabs_CacheInsight::css/cache-insight.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template" name="storvixlabs.cacheinsight.report"
                   template="StorvixLabs_CacheInsight::report.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">StorvixLabs\CacheInsight\ViewModel\Report</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
