<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="controller_action_predispatch">
        <observer name="storvixlabs_cacheinsight_miss" instance="StorvixLabs\CacheInsight\Observer\MarkMiss"/>
    </event>
    <event name="controller_front_send_response_before">
        <observer name="storvixlabs_cacheinsight_record" instance="StorvixLabs\CacheInsight\Observer\RecordRequest"/>
    </event>
</config>
